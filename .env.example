# URL of your running Uptime Kuma instance (reachable from this service).
UPTIME_KUMA_URL=http://uptime-kuma:3001

# Credentials of an Uptime Kuma user allowed to manage monitors.
UPTIME_KUMA_USERNAME=admin
UPTIME_KUMA_PASSWORD=change-me

# API key clients (e.g. your CRM) must send in the "X-API-Key" header.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-too

# Optional overrides
# DEFAULT_SCHEME=https
# DEFAULT_INTERVAL=60
# DEFAULT_RETRY_INTERVAL=60
# DEFAULT_MAX_RETRIES=0
# UPTIME_KUMA_TIMEOUT=15
